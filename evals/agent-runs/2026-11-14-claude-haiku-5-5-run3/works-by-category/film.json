{
  "vertical": "data-story",
  "lang": "zh",
  "title": "2,793 件作品都在做什么",
  "source": "数据来源：{{source.name}}（截至 {{source.asOf}}）",
  "theme": { "accent": "#62c6ff" },
  "voice": { "backend": "auto" },
  "scenes": [
    {
      "id": "open",
      "type": "title",
      "kicker": "公开清单 · AI 内容制作",
      "headline": "{{facts.total}} 件作品都在做什么",
      "sub": "按类型看这份清单的分布",
      "narration": [
        "这份清单收录了{{facts.total}}件作品。",
        "我们来看看它们都在做什么。"
      ]
    },
    {
      "id": "total",
      "type": "bignumber",
      "label": "作品总数",
      "value": "{{facts.total}}",
      "unit": "件",
      "note": "清单只收浏览量 {{facts.minViews}} 以上的作品",
      "narration": [
        "清单一共收了{{facts.total}}件作品。",
        "它只收浏览量{{facts.minViews}}以上的作品。",
        "所以它不代表全部。"
      ]
    },
    {
      "id": "categories",
      "type": "bars",
      "title": "作品按类型分布",
      "sub": "按件数从多到少排列",
      "series": { "$": "series.categories" },
      "highlight": "游戏",
      "unit": "件",
      "showShare": true,
      "narration": [
        "数量最多的是模型对比，有{{series.categories[模型对比]}}件。",
        "其次是游戏，有{{series.categories[游戏]}}件。"
      ]
    },
    {
      "id": "games",
      "type": "bignumber",
      "label": "游戏类作品",
      "value": "{{series.categories[游戏]}}",
      "unit": "件",
      "note": "占全部 {{share series.categories[游戏]}}",
      "narration": [
        "游戏类作品有{{series.categories[游戏]}}件。",
        "占全部作品的{{share series.categories[游戏]}}。"
      ]
    },
    {
      "id": "outro",
      "type": "outro",
      "headline": "这只是一份清单的快照",
      "sub": "{{source.name}}",
      "narration": [
        "以上数字都来自这份公开清单。",
        "它只统计高浏览量作品，不是全貌。"
      ]
    }
  ]
}
