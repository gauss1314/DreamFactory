{
  "vertical": "data-story",
  "lang": "zh",
  "title": "24 个品类，谁最多",
  "source": "数据来源：{{source.name}}（截至 {{source.asOf}}）",
  "theme": { "accent": "#62c6ff" },
  "voice": { "backend": "auto" },
